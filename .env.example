# Choose a local password; use URL-safe characters in both values.
POSTGRES_PASSWORD=replace_with_local_password
DATABASE_URL=postgresql://language_learning:replace_with_local_password@127.0.0.1:54329/language_learning

# Auth foundation only; routes are not enabled yet. Generate a random secret of at least 32 characters.
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
# Optional local SMTP port; host is always 127.0.0.1.
AUTH_SMTP_PORT=1025

# Optional for dictionary use; required to start learning.
TYPESAFE_API_KEY=
