{
  "name": "language-learning-local",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test && playwright test --config=playwright.learning.config.ts && playwright test --config=playwright.unavailable.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:isolation && pnpm test && pnpm test:database",
    "db:migrate": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "test:database": "node tests/integration/database.mjs",
    "test:isolation": "node --test tests/isolation/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.7.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "typescript": "^5.0.0"
  }
}
